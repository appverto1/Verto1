# Supabase Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional safety check: expected Supabase project ref (the subdomain before .supabase.co).
SUPABASE_EXPECTED_PROJECT_REF=
SUPABASE_PUBLISHABLE_KEY=
VERTO_APP_BASE_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:contato@verto.com.br

# Session Configuration
SESSION_SECRET=
SESSION_MAX_AGE_DAYS=30
# Patient/responsible portal sessions remain signed in on trusted devices longer.
PATIENT_PORTAL_SESSION_MAX_AGE_DAYS=90
PSEUDONYMIZATION_KEY=
DATA_ENCRYPTION_KEY=

# Stripe Configuration
# Explicit Stripe runtime: test in staging, live in production. Never infer from NODE_ENV.
STRIPE_ENVIRONMENT=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACTIVE_PATIENT_LOOKUP_KEY=verto_active_patients_monthly
STRIPE_ACTIVE_PATIENT_LOOKUP_KEYS=
STRIPE_ACTIVE_PATIENT_PRICE_ID=
# Optional paid add-on: active recurring monthly BRL price of exactly R$ 2.00 per patient for timeline capacity 1 -> 3.
STRIPE_EVOLUTION_TIMELINE_PLUS_PRICE_ID=
STRIPE_BILLING_PLAN_PRICE_IDS=
STRIPE_CLINIC_PLAN_PRICE_IDS=
STRIPE_ACTIVE_PATIENT_BILLING_MODE=quantity
ACTIVE_PATIENT_ENTERPRISE_THRESHOLD=50
PATIENT_BASED_BILLING_ENABLED=true
PATIENT_BASED_BILLING_TIERS=5:19700,10:29700,20:49700,30:69700,40:89700,50:109700
BILLING_PLAN_SNAPSHOT_TTL_MINUTES=10
STRIPE_ALLOW_OVER_299_USAGE=false
BILLING_CRON_SECRET=

# Database Configuration
DATABASE_URL=

# Firebase (if used)
FIREBASE_API_KEY=

# Transactional Email (Resend)
# Use a sender at a domain verified in Resend, for example:
# RESEND_FROM_EMAIL=Verto <naoresponda@updates.appverto.com.br>
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Published template IDs or aliases. The clinic invitation template receives
# `clinic_name`, `invited_professional_name`, `responsible_professional_name`,
# `invited_email`, `invited_role_label`, `link_ativacao` and compatibility `nome`.
# Patient activation uses the published alias `ativao-paciente` and declares
# exactly `activation_patient`, which receives the one-time server-generated URL.
# Password reset uses the published alias `password-reset` and declares exactly
# `reset_link`, which receives a short-lived signed URL. Template fallback URLs
# are previews only and are never the authority for a real activation/recovery.
# If a provider template is rejected, Verto sends the local HTML fallback and
# records only technical delivery details in internal logs.
RESEND_TEMPLATE_CLINIC_INVITATION_ID=
RESEND_TEMPLATE_WELCOME_PROFESSIONAL_ID=
RESEND_TEMPLATE_PATIENT_ACTIVATION_ID=ativao-paciente
# Legacy key accepted during rollout. Prefer RESEND_TEMPLATE_PATIENT_ACTIVATION_ID.
RESEND_TEMPLATE_WELCOME_PATIENT_ID=
RESEND_TEMPLATE_PASSWORD_RESET_ID=password-reset
# Legacy recovery template keys remain accepted during rollout. Prefer the
# neutral identity-level RESEND_TEMPLATE_PASSWORD_RESET_ID for new deployments.
RESEND_TEMPLATE_RECOVERY_PROFESSIONAL_ID=
RESEND_TEMPLATE_RECOVERY_PATIENT_ID=
# Server-only HMAC secret for signed password-recovery links. Use an independent
# random value of at least 32 bytes. If omitted, the backend may safely reuse
# SESSION_SECRET; never expose either value through a VITE_* variable.
PASSWORD_RECOVERY_LINK_SECRET=

# Commercial lead notifications (server-side only; never expose as VITE_*)
SALES_NOTIFICATION_EMAIL=appverto1@gmail.com

# Public WhatsApp number, international format with digits only.
# Changes to VITE_* variables require a new frontend build.
VITE_SALES_WHATSAPP_NUMBER=5511959348563

# Assisted commercial signup (server-side only; configure after code deployment)
SALES_ASSISTED_SIGNUP_ENABLED=true
SALES_OWNER_USER_ID=
STRIPE_BASE_ACTIVE_PATIENT_PRICE_ID=
STRIPE_COUPON_6_MONTHS_ID=
STRIPE_COUPON_12_MONTHS_ID=
STRIPE_COUPON_24_MONTHS_ID=

# ABA Measurement V3 rollout gates (dark by default)
FEATURE_ABA_V3_READ_API=false
FEATURE_ABA_V3_COLLECTION_API=false
# Read-only operational preflight. Safe to enable before collection/UI rollout.
FEATURE_ABA_V3_PREFLIGHT_API=false
# Separate mutation gate. Keep false except during an audited pilot rollout operation.
FEATURE_ABA_V3_ROLLOUT_ADMIN=false
VITE_FEATURE_ABA_V3_UI=false
