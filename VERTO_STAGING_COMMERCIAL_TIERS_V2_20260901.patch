diff --git a/tests/salesRecurringTieredCommercialModel20260901.regression.test.mjs b/tests/salesRecurringTieredCommercialModel20260901.regression.test.mjs
new file mode 100644
index 0000000..d773edb
--- /dev/null
+++ b/tests/salesRecurringTieredCommercialModel20260901.regression.test.mjs
@@ -0,0 +1,115 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+
+const builder = readFileSync('src/components/SalesModularProposalBuilder.tsx', 'utf8');
+const publicOffer = readFileSync('src/components/PublicSalesOffer.tsx', 'utf8');
+const engine = readFileSync('src/utils/salesModularProposal.ts', 'utf8');
+const server = readFileSync('server.ts', 'utf8');
+const stripeService = readFileSync('services/stripeService.ts', 'utf8');
+const migration = readFileSync(
+  'supabase/migrations/20260901223000_sales_monthly_billable_patients_and_bidirectional_capacity_v2.sql',
+  'utf8',
+);
+
+// New proposals use the explicit standard capacity bands and keep the internal
+// economic target visible to the owner without turning margin into a sales gate.
+assert.match(builder, /SALES_PATIENT_CAPACITY_BLOCKS = \[10, 20, 30, 40, 50\]/);
+assert.match(builder, /SALES_HEALTHY_MODULE_MARGIN_BASIS_POINTS = 8000/);
+assert.match(builder, /SALES_ATTENTION_MODULE_MARGIN_BASIS_POINTS = 7000/);
+assert.match(builder, /Margem de contribuição consolidada/);
+assert.match(builder, /meta 80%/);
+assert.match(builder, /Indicador interno; não é enviado ao cliente/);
+assert.match(builder, /Desconto negociado recorrente/);
+assert.doesNotMatch(builder, />\s*Período de teste\s*</);
+
+// New sales cannot reintroduce trials through a crafted request. Historical
+// fields remain readable for backwards compatibility, but v3 checkout fails closed.
+assert.match(engine, /trialDays\?: 0/);
+assert.match(engine, /Number\(input\.trialDays \?\? 0\) !== 0/);
+assert.match(server, /trialDays: 0/);
+assert.match(server, /MODULAR_CHECKOUT_TRIAL_NOT_ALLOWED/);
+assert.match(server, /commercialPresentationVersion >= SALES_CUSTOMER_FACING_PRESENTATION_VERSION/);
+
+// Customer-facing v3 does not receive per-module commercial economics. The
+// public experience shows only included modules, contracted band and final total.
+assert.match(server, /const compactCommercialPresentation = presentationVersion >= 3/);
+assert.match(server, /if \(compactCommercialPresentation\) return basic/);
+assert.match(server, /commercialPhases: compactCommercialPresentation[\s\S]{0,40}?\? \[\]/);
+assert.match(server, /capacityBlockPhases: compactCommercialPresentation[\s\S]{0,40}?\? \[\]/);
+assert.match(publicOffer, /Plano Verto para sua clínica/);
+assert.match(publicOffer, /Até \{contractedCapacity\} pacientes ativos/);
+assert.match(publicOffer, /Faixas de 10, 20, 30, 40 e 50 pacientes/);
+assert.match(publicOffer, /desconto recorrente neste contrato/);
+
+// Billable patient is monthly appointment-driven, DISTINCT by patient and
+// persisted as one auditable snapshot. Cancelled/invalid appointments do not
+// count; no-show remains a scheduled session and is not excluded by this rule.
+assert.match(migration, /organization_monthly_billable_patient_snapshots/);
+assert.match(migration, /array_agg\(distinct a\.patient_id/);
+assert.match(migration, /a\.scheduled_at >= v_start/);
+assert.match(migration, /a\.scheduled_at < v_end/);
+assert.match(migration, /'cancelled','canceled','cancelada','cancelado'/);
+assert.doesNotMatch(
+  migration.match(/lower\(coalesce\(a\.status,[\s\S]*?\)\s+and coalesce\(\(to_jsonb\(p\)/)?.[0] || '',
+  /no_show|missed|faltou/,
+);
+assert.match(migration, /unique \(organization_id, billing_month\)/);
+assert.match(migration, /if not p_force_refresh then/);
+assert.match(migration, /resolve_monthly_billable_patient_count_v1\(clinic\.id, null, true, true\)/);
+assert.match(stripeService, /p_force_refresh: false/);
+assert.match(migration, /is_final boolean not null default false/);
+assert.match(migration, /where public\.organization_monthly_billable_patient_snapshots\.is_final = false/);
+assert.match(migration, /revoke all on table public\.organization_monthly_billable_patient_snapshots from public, anon, authenticated/);
+assert.match(migration, /grant[\s\S]{0,120}?organization_monthly_billable_patient_snapshots to service_role/);
+assert.match(stripeService, /resolve_monthly_billable_patient_count_v1/);
+assert.match(stripeService, /\.select\('patient_id,status'\)/);
+assert.match(stripeService, /Array\.from\(new Set/);
+
+// New contracts are bidirectional while v1 remains upgrade-only for historical
+// customers. Stripe adjustments explicitly disable mid-cycle proration.
+assert.match(server, /billingModel: bidirectionalStandardTiers \? "modular_capacity_v2"/);
+assert.match(server, /standardCapacityTiers = \[10, 20, 30, 40, 50\]/);
+assert.match(server, /MODULAR_CAPACITY_STANDARD_TIER_SNAPSHOT_MISMATCH/);
+assert.match(migration, /'modular_capacity_v1', 'modular_capacity_v2'/);
+const v2Branch = stripeService.match(
+  /if \(contract\.billingModel === 'modular_capacity_v2'\) \{[\s\S]*?\n  const effectiveLimit =/
+)?.[0] || '';
+assert.match(v2Branch, /targetAdditionalBlocks/);
+assert.match(v2Branch, /capacity_upgrade_scheduled/);
+assert.match(v2Branch, /capacity_downgrade_scheduled/);
+assert.doesNotMatch(v2Branch, /Math\.max\(\s*contract\.billedAdditionalBlocks,/);
+const v1Branch = stripeService.slice(stripeService.indexOf('const effectiveLimit ='));
+assert.match(v1Branch, /Math\.max\(\s*contract\.billedAdditionalBlocks,/);
+assert.match(stripeService, /proration_behavior: 'none'/);
+
+const targetTier = (activePatients) => {
+  const baseLimit = 10;
+  const blockSize = 10;
+  const cappedPatients = Math.min(Math.max(activePatients, 1), 50);
+  const blocks = Math.max(0, Math.ceil(Math.max(cappedPatients - baseLimit, 0) / blockSize));
+  return baseLimit + blocks * blockSize;
+};
+assert.equal(targetTier(0), 10);
+assert.equal(targetTier(10), 10);
+assert.equal(targetTier(11), 20);
+assert.equal(targetTier(20), 20);
+assert.equal(targetTier(21), 30);
+assert.equal(targetTier(31), 40);
+assert.equal(targetTier(41), 50);
+assert.equal(targetTier(50), 50);
+assert.equal(targetTier(51), 50);
+
+// Preserve the Stripe payment hotfix already validated in staging/main.
+const scheduleBlock = server.match(
+  /const ensureModularSubscriptionSchedule = async \([\s\S]*?\n  const reconcileSalesAssistedCheckout = async \(/
+)?.[0] || '';
+assert.match(
+  scheduleBlock,
+  /subscriptionSchedules\.create\(\n\s*\{ from_subscription: subscriptionId \},/,
+);
+assert.doesNotMatch(
+  scheduleBlock,
+  /subscriptionSchedules\.create\(\s*\{\s*from_subscription:[\s\S]{0,240}?metadata\s*:/,
+);
+
+console.log('salesRecurringTieredCommercialModel20260901.regression.test.mjs: OK');
