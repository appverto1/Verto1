diff --git a/supabase/migrations/20260901223000_sales_monthly_billable_patients_and_bidirectional_capacity_v2.sql b/supabase/migrations/20260901223000_sales_monthly_billable_patients_and_bidirectional_capacity_v2.sql
new file mode 100644
index 0000000..0bd3cf2
--- /dev/null
+++ b/supabase/migrations/20260901223000_sales_monthly_billable_patients_and_bidirectional_capacity_v2.sql
@@ -0,0 +1,233 @@
+-- Verto commercial billing v2
+-- 1) Billable patient = registered patient with at least one valid appointment in the clinic month.
+-- 2) Persist one monthly billing snapshot per clinic/month for audit/reuse.
+-- 3) Allow new modular capacity contracts to move bidirectionally across 10/20/30/40/50 tiers.
+-- Historical modular_capacity_v1 contracts remain untouched.
+
+begin;
+
+create table if not exists public.organization_monthly_billable_patient_snapshots (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null references public.clinics(id) on delete cascade,
+  billing_month date not null,
+  timezone text not null,
+  billable_patient_count integer not null check (billable_patient_count >= 0),
+  patient_ids uuid[] not null default '{}'::uuid[],
+  rule_version text not null default 'scheduled_session_month_v1',
+  is_final boolean not null default false,
+  observed_at timestamptz not null default now(),
+  finalized_at timestamptz,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  unique (organization_id, billing_month)
+);
+
+create index if not exists idx_org_monthly_billable_patient_snapshots_month
+  on public.organization_monthly_billable_patient_snapshots (billing_month, organization_id);
+
+alter table public.organization_monthly_billable_patient_snapshots enable row level security;
+revoke all on table public.organization_monthly_billable_patient_snapshots from public, anon, authenticated;
+grant select, insert, update, delete on table public.organization_monthly_billable_patient_snapshots to service_role;
+
+create or replace function public.resolve_monthly_billable_patient_count_v1(
+  p_clinic_id uuid,
+  p_billing_month date default null,
+  p_persist_snapshot boolean default true,
+  p_force_refresh boolean default false
+)
+returns integer
+language plpgsql
+security definer
+set search_path = pg_catalog, public
+as $function$
+declare
+  v_timezone text := 'America/Sao_Paulo';
+  v_month date;
+  v_start timestamptz;
+  v_end timestamptz;
+  v_patient_ids uuid[] := '{}'::uuid[];
+  v_count integer := 0;
+begin
+  if p_clinic_id is null then
+    return 0;
+  end if;
+
+  select coalesce(nullif(trim(coalesce(to_jsonb(c)->>'timezone', '')), ''), 'America/Sao_Paulo')
+    into v_timezone
+  from public.clinics c
+  where c.id = p_clinic_id;
+
+  if not found then
+    return 0;
+  end if;
+
+  v_month := coalesce(
+    p_billing_month,
+    date_trunc('month', now() at time zone v_timezone)::date
+  );
+  v_start := (v_month::timestamp at time zone v_timezone);
+  v_end := ((v_month + interval '1 month')::timestamp at time zone v_timezone);
+
+  -- Hot-path reads reuse the monthly snapshot. The scheduled reconciler is the
+  -- canonical refresh point, so application calls do not repeatedly aggregate
+  -- appointments for the same clinic/month (registre 1x, leia várias).
+  if not p_force_refresh then
+    select snapshot.billable_patient_count
+      into v_count
+    from public.organization_monthly_billable_patient_snapshots snapshot
+    where snapshot.organization_id = p_clinic_id
+      and snapshot.billing_month = v_month
+    limit 1;
+    if found then
+      return coalesce(v_count, 0);
+    end if;
+  end if;
+
+  select coalesce(array_agg(distinct a.patient_id order by a.patient_id), '{}'::uuid[])
+    into v_patient_ids
+  from public.appointments a
+  join public.patients p
+    on p.id = a.patient_id
+   and p.clinic_id = p_clinic_id
+  where a.clinic_id = p_clinic_id
+    and a.patient_id is not null
+    and a.scheduled_at >= v_start
+    and a.scheduled_at < v_end
+    and coalesce((to_jsonb(a)->>'deleted_at'), '') = ''
+    and coalesce((to_jsonb(a)->>'is_active')::boolean, true) = true
+    and lower(coalesce(a.status, 'scheduled')) not in (
+      'cancelled','canceled','cancelada','cancelado','cancelled_by_clinic',
+      'cancelado_pela_clinica','cancelled_by_patient','cancelado_pelo_paciente',
+      'deleted','archived','inactive','rejected','recusado','recusada','invalid'
+    )
+    and coalesce((to_jsonb(p)->>'deleted_at'), '') = '';
+
+  v_count := coalesce(array_length(v_patient_ids, 1), 0);
+
+  if p_persist_snapshot then
+    insert into public.organization_monthly_billable_patient_snapshots (
+      organization_id,
+      billing_month,
+      timezone,
+      billable_patient_count,
+      patient_ids,
+      rule_version,
+      is_final,
+      observed_at,
+      updated_at
+    ) values (
+      p_clinic_id,
+      v_month,
+      v_timezone,
+      v_count,
+      v_patient_ids,
+      'scheduled_session_month_v1',
+      false,
+      now(),
+      now()
+    )
+    on conflict (organization_id, billing_month) do update
+      set timezone = excluded.timezone,
+          billable_patient_count = excluded.billable_patient_count,
+          patient_ids = excluded.patient_ids,
+          rule_version = excluded.rule_version,
+          observed_at = excluded.observed_at,
+          updated_at = now()
+      where public.organization_monthly_billable_patient_snapshots.is_final = false;
+  end if;
+
+  return v_count;
+end;
+$function$;
+
+revoke all on function public.resolve_monthly_billable_patient_count_v1(uuid, date, boolean, boolean)
+  from public, anon, authenticated;
+grant execute on function public.resolve_monthly_billable_patient_count_v1(uuid, date, boolean, boolean)
+  to service_role;
+
+-- The scheduled reconciler now uses the same canonical monthly rule as runtime reads.
+create or replace function public.reconcile_active_patient_billing_sync_queue(
+  p_trigger text default 'scheduled_reconciliation'
+)
+returns integer
+language plpgsql
+security definer
+set search_path = pg_catalog, public
+as $function$
+declare
+  v_count integer;
+begin
+  with billable_counts as (
+    select
+      clinic.id as clinic_id,
+      public.resolve_monthly_billable_patient_count_v1(clinic.id, null, true, true) as active_patient_count
+    from public.clinics clinic
+    where nullif(coalesce(to_jsonb(clinic)->>'stripe_subscription_id', ''), '') is not null
+      and coalesce(lower(to_jsonb(clinic)->>'billing_model'), '') <> 'demo'
+  ), reconciled as (
+    insert into public.active_patient_billing_sync_queue as queue_row (
+      clinic_id,
+      desired_active_patient_count,
+      queue_version,
+      status,
+      attempts,
+      next_attempt_at,
+      trigger,
+      created_at,
+      updated_at
+    )
+    select
+      billable_counts.clinic_id,
+      billable_counts.active_patient_count,
+      1,
+      'pending',
+      0,
+      now(),
+      coalesce(nullif(trim(p_trigger), ''), 'scheduled_reconciliation'),
+      now(),
+      now()
+    from billable_counts
+    on conflict (clinic_id) do update
+    set
+      desired_active_patient_count = excluded.desired_active_patient_count,
+      queue_version = case
+        when queue_row.desired_active_patient_count is distinct from excluded.desired_active_patient_count
+          then queue_row.queue_version + 1
+        else queue_row.queue_version
+      end,
+      status = case
+        when queue_row.desired_active_patient_count is distinct from excluded.desired_active_patient_count
+          then case when queue_row.status = 'processing' then 'processing' else 'pending' end
+        else queue_row.status
+      end,
+      attempts = case
+        when queue_row.desired_active_patient_count is distinct from excluded.desired_active_patient_count
+             and queue_row.status <> 'processing'
+          then 0
+        else queue_row.attempts
+      end,
+      next_attempt_at = case
+        when queue_row.desired_active_patient_count is distinct from excluded.desired_active_patient_count then now()
+        else queue_row.next_attempt_at
+      end,
+      trigger = excluded.trigger,
+      updated_at = now()
+    returning clinic_id
+  )
+  select count(*) into v_count from reconciled;
+
+  return coalesce(v_count, 0);
+end;
+$function$;
+
+-- Permit the new bidirectional contract only for newly provisioned sales.
+alter table public.organization_billing_contracts
+  drop constraint if exists organization_billing_contracts_billing_model_check;
+
+alter table public.organization_billing_contracts
+  add constraint organization_billing_contracts_billing_model_check
+  check (billing_model in ('modular_capacity_v1', 'modular_capacity_v2'));
+
+notify pgrst, 'reload schema';
+
+commit;
